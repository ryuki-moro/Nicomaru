{
  "name": "bridalhub",
  "version": "0.1.0",
  "private": true,
  "description": "にこまる (BridalHub) — 結婚式準備進行管理アプリ",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "dev": "next dev",
    "dev:admin": "tsx scripts/dev-admin.mts",
    "demo": "node scripts/demo-server.mjs",
    "test:demo": "node --test tests/demo/*.test.mjs",
    "test:demo:browser": "node --test tests/demo/browser-smoke.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:types": "supabase gen types typescript --local > src/lib/db/database.types.ts",
    "test:pg": "vitest run tests/db/concurrency.test.ts tests/db/demo-seed-pg.test.ts",
    "worker:ai": "tsx worker/ai-worker.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-system-admin.mts",
    "demo:seed": "tsx scripts/seed-demo.mts",
    "demo:reset": "tsx scripts/seed-demo.mts --reset",
    "screenshots": "tsx scripts/screenshots.mts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "vitest run --config vitest.coverage.config.ts",
    "progress:check": "node scripts/render-progress.mjs --check",
    "dev:d1": "node --import tsx scripts/d1-local.mjs",
    "db:d1:setup": "node --import tsx scripts/d1-local.mjs --setup-only",
    "test:d1": "node --import tsx --test tests/d1/*.test.mjs",
    "test:d1:browser": "node --test --test-concurrency=1 tests/d1/browser.mjs tests/d1/onboarding.browser.mjs tests/d1/tasks.browser.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.112.4",
    "better-auth": "1.7.12",
    "next": "15.5.28",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261023.1",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/compat": "^2.0.0",
    "@next/eslint-plugin-next": "14.2.35",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.8",
    "pg": "^8.23.1",
    "postcss": "^8.5.29",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "@next/eslint-plugin-next": {
      ".": "$@next/eslint-plugin-next",
      "glob": "10.5.0"
    }
  }
}
