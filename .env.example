# BridalHub / にこまる — 環境変数
# 正本: 基本設計書 Version 1.2 表12-2「環境変数」。
# 実際の値はコミットしない。本ファイルはキー名と用途の記録のみ（12章 秘密情報管理）。

# Cloudflare D1 + Better Auth（本番はWorkersのsecretとDB bindingを使用）
NICOMARU_DB=d1
NEXT_PUBLIC_NICOMARU_DB=d1
BETTER_AUTH_SECRET=<random string, 32+ chars>

# ---- 個人情報の暗号化（13-1 開発チーム決定） --------------------------------
# いずれも base64 で 32 バイト。生成例: openssl rand -base64 32
PII_ENCRYPTION_KEY=<base64 32 bytes>
PII_HMAC_KEY=<base64 32 bytes>

# ---- 外部連携 ---------------------------------------------------------------
RESEND_API_KEY=<resend api key>
RESEND_FROM=BridalHub <noreply@example.com>


# ローカルLLM（Phase 3）
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_API_KEY=<optional>
# 未設定ならワーカーの既定 gemma3:12b を使う。下は VRAM の少ない機器向けの例。
# どちらにするかは担当者が機器に合わせて選ぶ（docs/メンバー向けデモと運用手順.md）。
OLLAMA_MODEL=qwen2.5:7b

# AIジョブワーカー（7-3）。ローカルLLMサーバー側の .env にのみ置く。
# アプリのHTTPS APIのみ使用。トークンはWorkersのsecretと同じ値。
AI_WORKER_API_URL=https://<アプリのURL>
AI_WORKER_TOKEN=<random string, 32+ chars>

# ---- 内部呼び出し -----------------------------------------------------------
# 定期処理・AIワーカーの共有シークレット（6-5-2）
INTERNAL_CRON_SECRET=<random string>

# 招待URL・通知URLの生成に使う
APP_BASE_URL=http://127.0.0.1:3000

# ---- 容量・監視（契約の管理画面で確認した値を設定。未設定を0%と表示しない） ---
DB_CAPACITY_LIMIT_BYTES=
STORAGE_CAPACITY_LIMIT_BYTES=
# 有効化した定期処理のみカンマ区切り。空ならアプリの標準ジョブを監視する
MONITOR_ENABLED_JOBS=
