# BridalHub / にこまる — 環境変数
# 正本: 基本設計書 Version 1.2 表12-2「環境変数」。
# 実際の値はコミットしない。本ファイルはキー名と用途の記録のみ（12章 秘密情報管理）。

# ---- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
# RLS をバイパスする。サーバー側のみで使用し、使用箇所は 6-3-5 表6-4 に限定する
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# ---- 個人情報の暗号化（13-1 開発チーム決定） --------------------------------
# いずれも base64 で 32 バイト。生成例: openssl rand -base64 32
PII_ENCRYPTION_KEY=<base64 32 bytes>
PII_HMAC_KEY=<base64 32 bytes>

# ---- 外部連携 ---------------------------------------------------------------
# メール送信（招待URL・通知・パスワード再設定）。Supabase Auth の Custom SMTP にも同じ経路を使う
RESEND_API_KEY=<resend api key>
RESEND_FROM=BridalHub <noreply@example.com>

# LINE Messaging API（Phase 2）
LINE_CHANNEL_ACCESS_TOKEN=<line channel access token>
LINE_CHANNEL_SECRET=<line channel secret>

# ローカルLLM（Phase 3）
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_API_KEY=<optional>

# ---- 内部呼び出し -----------------------------------------------------------
# 定期処理・AIワーカーの共有シークレット（6-5-2）
INTERNAL_CRON_SECRET=<random string>

# 招待URL・通知URLの生成に使う
APP_BASE_URL=http://localhost:3000
