// Cloudflare本番（OpenNext）。ローカル検証は cloudflare/wrangler.jsonc を使う。
// APP_BASE_URL と秘密値はダッシュボードで設定する。送信元は秘密ではないためここで固定する。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nicomaru",
  "main": "cloudflare/app-worker.mjs",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // CHAT はチャットWorker(cloudflare/chat)。CHAT_WS_URL・CHAT_TICKET_SECRET はダッシュボードで設定する。
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "nicomaru" },
    { "binding": "CHAT", "service": "nicomaru-chat" },
  ],
  // ダッシュボードで設定した APP_BASE_URL・秘密値を配備で消さない。
  "keep_vars": true,
  "vars": {
    "NICOMARU_DB": "d1",
    "NEXT_PUBLIC_NICOMARU_DB": "d1",
    "RESEND_FROM": "Bellink <onboarding@resend.dev>",
    // on の間は確認コード等を外部送信せず system_admin の受信箱へ保存する。Gmail SMTP で実送信するため off。
    "DEMO_MAILBOX": "off",
    // チャットの WebSocket 接続先（nicomaru-chat Worker）
    "CHAT_WS_URL": "wss://nicomaru-chat.nicomaru-app.workers.dev/ws",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nicomaru",
      "database_id": "9a210477-8a24-482b-a138-a04f1cdc4bdc",
      "migrations_dir": "cloudflare/migrations",
    },
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "nicomaru-files" }],
  "observability": { "enabled": true },
}
